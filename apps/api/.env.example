# API listen port; blank uses 8787.
PORT=
# SQLite file path; blank uses rickshare.sqlite in the API directory.
DATABASE_PATH=
# Allowed browser origin; blank uses http://localhost:5173.
WEB_ORIGIN=
# Arc HTTP RPC endpoint; optional until chain integration.
ARC_RPC_URL=
# Arc WebSocket RPC endpoint; optional until indexing.
ARC_WS_URL=
# Ethereum Sepolia RPC endpoint; optional until ENS integration.
SEPOLIA_RPC_URL=
# Deployed factory address; optional until A5.
TRIP_FACTORY_ADDRESS=
# Proposer-only private key; optional until A9.
AGENT_PRIVATE_KEY=
# Dedicated app wallet that funds trip-creation fees on Arc testnet. Fund it with test USDC.
GAS_SPONSOR_PRIVATE_KEY=
# Maximum sponsored fee per creation, in USDC; blank uses 1.
GAS_SPONSOR_MAX_FEE_USDC=
# Total daily gas allowance for the app, in USDC; blank uses 10 (UTC).
GAS_SPONSOR_DAILY_BUDGET_USDC=
# Approval attestation signing key; optional until A8.
VERIFIER_PRIVATE_KEY=
# ENS management key; optional until B9.
ENS_ADMIN_PRIVATE_KEY=
# ENS parent name; optional until B9.
ENS_PARENT_NAME=
# World Agent Pass OIDC issuer: https://auth.world.org (required for World routes).
WORLD_ISSUER=
# World application client identifier; optional until A8.
WORLD_CLIENT_ID=
# World application secret; optional until A8.
WORLD_CLIENT_SECRET=
# Exact registered HTTPS callback, e.g. https://rickshare.xyz/api/world/callback behind the web proxy.
WORLD_REDIRECT_URI=
# Maximum authentication age in seconds; blank uses 300.
WORLD_MAX_AUTH_AGE_SECONDS=
# Attestation lifetime in seconds; blank uses 300.
ATTESTATION_TTL_SECONDS=
# OpenRouter API key for the trip agent; blank disables agent replies.
OPENROUTER_API_KEY=
# OpenRouter model id with tool calling, e.g. anthropic/claude-haiku-5.5; blank uses openai/gpt-oss-120b.
OPENROUTER_MODEL=
# Activity search API key; optional until B5.
TAVILY_API_KEY=
# Merchant service URL; blank uses http://localhost:8790.
MERCHANTS_URL=
# Shared server-to-server ticket lookup secret; match the merchant service.
MERCHANTS_API_SECRET=
# Session signing secret of at least 32 characters; optional until A6.
SESSION_SECRET=
# Sign-in challenge lifetime in seconds (60–600); blank uses 300.
AUTH_NONCE_TTL_SECONDS=
# Revocable session lifetime in seconds (60–604800); blank uses 28800.
SESSION_TTL_SECONDS=
# First factory deployment block to scan; blank starts at block zero.
ARC_START_BLOCK=
# Chain-indexing polling interval in milliseconds; blank uses 2000. Public Arc RPC: use 10000.
INDEXER_POLL_INTERVAL_MS=10000
