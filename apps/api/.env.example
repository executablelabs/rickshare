# API listen port; blank uses 8787.
PORT=
# SQLite file path; blank uses kitty.sqlite in the API directory.
DATABASE_PATH=
# Allowed browser origin; blank uses http://localhost:5173.
WEB_ORIGIN=
# Arc HTTP RPC endpoint; optional until chain integration.
ARC_RPC_URL=
# Arc WebSocket RPC endpoint; optional until indexing.
ARC_WS_URL=
# Ethereum Sepolia RPC endpoint; optional until ENS integration.
SEPOLIA_RPC_URL=
# Deployed factory address; optional until A5.
TRIP_FACTORY_ADDRESS=
# Proposer-only private key; optional until A9.
AGENT_PRIVATE_KEY=
# Approval attestation signing key; optional until A8.
VERIFIER_PRIVATE_KEY=
# ENS management key; optional until B9.
ENS_ADMIN_PRIVATE_KEY=
# ENS parent name; optional until B9.
ENS_PARENT_NAME=
# World OIDC issuer: https://id.worldcoin.org (required for World routes).
WORLD_ISSUER=
# World application client identifier; optional until A8.
WORLD_CLIENT_ID=
# World application secret; optional until A8.
WORLD_CLIENT_SECRET=
# Registered API callback, e.g. http://localhost:8787/world/callback.
WORLD_REDIRECT_URI=
# Maximum authentication age in seconds; blank uses 300.
WORLD_MAX_AUTH_AGE_SECONDS=
# Attestation lifetime in seconds; blank uses 300.
ATTESTATION_TTL_SECONDS=
# Agent model API key; optional until B5.
ANTHROPIC_API_KEY=
# Activity search API key; optional until B5.
TAVILY_API_KEY=
# Merchant service URL; blank uses http://localhost:8790.
MERCHANTS_URL=
# Session signing secret of at least 32 characters; optional until A6.
SESSION_SECRET=
# Sign-in challenge lifetime in seconds (60–600); blank uses 300.
AUTH_NONCE_TTL_SECONDS=
# Revocable session lifetime in seconds (60–604800); blank uses 28800.
SESSION_TTL_SECONDS=
# First factory deployment block to scan; blank starts at block zero.
ARC_START_BLOCK=
# Chain-indexing polling interval in milliseconds; blank uses 2000.
INDEXER_POLL_INTERVAL_MS=
