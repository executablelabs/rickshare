# Merchant service listen port; blank uses 8790.
PORT=
# Arc HTTP RPC endpoint; optional until A10.
ARC_RPC_URL=
# Deployed factory address; optional until A10.
TRIP_FACTORY_ADDRESS=
# Elephanta merchant signing key; optional until A10.
MERCHANT_1_PRIVATE_KEY=
# Goa merchant signing key; optional until A10.
MERCHANT_2_PRIVATE_KEY=
# Deccan merchant signing key; optional until A10.
MERCHANT_3_PRIVATE_KEY=
# Merchant service public URL; blank uses http://localhost:8790.
PUBLIC_URL=
# Durable merchant quote, ticket and delivery-job database; blank uses merchants.sqlite.
MERCHANT_DATABASE_PATH=
# Shared server-to-server ticket lookup secret (at least 32 characters).
MERCHANTS_API_SECRET=
# Delivery watcher polling interval in milliseconds; blank uses 2000. Public Arc RPC: use 10000.
MERCHANT_POLL_INTERVAL_MS=10000
# First factory deployment block to scan; blank starts at zero.
ARC_START_BLOCK=
# Enable x402 v2 booking checkout; blank/false keeps vault fulfillment for new quotes.
X402_ENABLED=
# First supported checkout network: Base Sepolia (separate from the Arc trip vault).
X402_NETWORK=eip155:84532
# Public testnet facilitator; must advertise x402 v2 exact support for X402_NETWORK.
X402_FACILITATOR_URL=https://x402.org/facilitator
