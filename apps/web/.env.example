# Public API base URL; use /api behind the production web proxy. Blank uses http://localhost:8787.
VITE_API_URL=
# Public Arc RPC URL; blank uses the chain's default public RPC. Do not include secrets.
VITE_ARC_RPC_URL=
# Public Ethereum Sepolia RPC URL; optional until B9.
VITE_SEPOLIA_RPC_URL=
# Public Privy app ID. Enable email, Google and wallet login, and allow this web origin in Privy.
# Blank shows a configuration-missing screen. Never put a Privy app secret in VITE_ variables.
VITE_PRIVY_APP_ID=
