{
  "name": "rickshare",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun scripts/start-service.ts",
    "dev": "bun --parallel --filter './apps/*' dev",
    "lint": "biome ci .",
    "fmt": "biome format --write .",
    "typecheck": "bun --filter './packages/*' --filter './apps/*' typecheck && tsc -p tsconfig.scripts.json",
    "test": "bun --filter './packages/*' --filter './apps/*' test",
    "abi": "bun --filter @rickshare/shared abi",
    "check": "bun run lint && bun run typecheck && bun run test",
    "contracts:deploy": "bun --env-file packages/contracts/.env scripts/deploy.ts",
    "demo:prepare": "bun run scripts/prepare.ts",
    "demo:seed": "bun --env-file scripts/demo.env scripts/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@rickshare/shared": "workspace:*",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3",
    "viem": "2.57.16",
    "zod": "4.6.7"
  }
}
