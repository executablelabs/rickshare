# Arc testnet RPC; use a loopback Anvil endpoint only with --local.
ARC_RPC_URL=
# Testnet deployer key, also used to fund generated demo wallets.
DEPLOYER_PRIVATE_KEY=
# Optional existing factory address; otherwise deploy using contracts:deploy.
TRIP_FACTORY_ADDRESS=
# Public proposer address matching the API agent key.
AGENT_ADDRESS=
# Public attestation verifier address matching the API verifier key.
VERIFIER_ADDRESS=
# Public merchant quote/payment addresses matching merchant keys.
MERCHANT_1_ADDRESS=
MERCHANT_2_ADDRESS=
MERCHANT_3_ADDRESS=
# Demo wallet keys controlled by this operator, never real-user wallet keys.
DEMO_MEMBER_1_PRIVATE_KEY=
DEMO_MEMBER_2_PRIVATE_KEY=
DEMO_MEMBER_3_PRIVATE_KEY=
# Deposit per member as a decimal USDC amount; blank uses 100.
DEMO_DEPOSIT_USDC=
# Trip display name; blank uses India 26.
DEMO_TRIP_NAME=
